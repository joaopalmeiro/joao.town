{
  "name": "joao.town",
  "version": "0.0.0",
  "private": true,
  "description": "My personal website.",
  "license": "MIT",
  "author": {
    "name": "João Palmeiro",
    "email": "joaopalmeiro@proton.me",
    "url": "https://joao.town/"
  },
  "type": "module",
  "scripts": {
    "build": "run-s build:md build:llms build:static",
    "build:llms": "node scripts/genLlmsFull.ts",
    "build:md": "node scripts/genMd.ts",
    "build:static": "astro build",
    "check:meta": "check-site-meta 4321",
    "deploy": "wrangler deploy",
    "dev": "astro dev",
    "format": "prettier . --write",
    "lint": "rumdl check .",
    "preview": "astro preview --host --allowed-hosts host.rancher-desktop.internal",
    "test": "PW_TEST_CONNECT_WS_ENDPOINT=ws://127.0.0.1:3000/ playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.2",
    "@fontsource/special-elite": "5.2.8",
    "astro": "5.16.11",
    "tailwindcss": "4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.2.0",
    "@types/node": "24.12.0",
    "check-site-meta": "0.3.9",
    "mdbox": "0.1.1",
    "npm-run-all2": "8.0.4",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "rumdl": "0.1.62",
    "wrangler": "4.77.0"
  }
}
