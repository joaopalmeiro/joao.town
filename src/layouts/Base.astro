---
import "@fontsource/special-elite";

import "../styles/global.css";

const { title, description } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="author" content="João Palmeiro" />
    <meta name="description" content={description} />
  </head>

  <body
    class="px-6 py-12 text-base text-gray-900 selection:bg-gray-900 selection:text-white print:p-0 print:text-sm"
  >
    <div class="mx-auto flex max-w-prose flex-col gap-8 print:max-w-none">
      <slot />
    </div>
  </body>
</html>
