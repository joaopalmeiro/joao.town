    </div>

    <dl>
      <dt>Pronouns</dt>
      <dd>he/him</dd>

      <dt>Location</dt>
      <dd>Lisbon, Portugal (UTC+00:00 or +01:00)</dd>

      <dt>Contact</dt>
      <dd>
        <address>
          <a href="mailto:joaopalmeiro@proton.me">joaopalmeiro@proton.me</a>
        </address>
      </dd>
    </dl>
  </header>

  <main class="flex flex-col gap-8">
    <article>
      <h2><span aria-hidden="true">~ </span>Profile</h2>

