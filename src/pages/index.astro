---
import Layout from "../layouts/Base.astro";

const kaomoji = { text: "<( ^.^ )>", label: "Happy Kirby" };
---

<Layout title="João Palmeiro" description="My personal website.">
  <header>
    <div class="flex justify-between">
      <h1 lang="pt-PT">
        <span aria-hidden="true">~ </span>João Palmeiro
      </h1>
      <span role="img" aria-label={kaomoji.label}>{kaomoji.text}</span>
    </div>

    <dl>
      <div class="flex gap-x-1">
        <dt>Pronouns:</dt>
        <dd>he/him</dd>
      </div>

      <div class="flex gap-x-1">
        <dt>Location:</dt>
        <dd>Lisbon, Portugal (UTC+00:00 or +01:00)</dd>
      </div>

      <div class="flex gap-x-1">
        <dt>Contact:</dt>
        <dd>
          <address>
            <a href="mailto:joaopalmeiro@proton.me">joaopalmeiro@proton.me</a>
          </address>
        </dd>
      </div>
    </dl>
  </header>

  <main class="flex flex-col gap-8">
    <article>
      <h2><span aria-hidden="true">~ </span>Profile</h2>

      <p>
        A mix of data visualization practitioner, researcher, and software engineer. Experienced in developing tools and
        features from ideation to production code, including project management. Mainly familiar with the Python
