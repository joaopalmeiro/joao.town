---
import { z } from "astro/zod";

import Layout from "../layouts/Base.astro";
import { shuffle } from "../utils";

const id = `OS_${shuffle("JOÃOPALMEIRO")}_${new Date().toISOString().slice(0, 10).replaceAll("-", "")}`;
const kaomoji = { text: "<(^_^<)", label: "Joyful Kirby" };

const repo = encodeURIComponent("joaommpalmeiro/os-contribs");
const filePath = encodeURIComponent("data/contribs.json");
const ref = "main";
const url = `https://gitlab.com/api/v4/projects/${repo}/repository/files/${filePath}/raw?ref=${ref}`;

const Datum = z.object({
  repo: z.string(),
  url: z.string().url(),
  title: z.string(),
  mr_pr: z.string().url(),
  merged_at: z.coerce.date(),
});
const Data = z.array(Datum);

const response = await fetch(url);
const rawData = await response.json();
const data = Data.parse(rawData);
---

<Layout title="Contribs | João Palmeiro" description="My open source contributions.">
  <header>
    <div class="flex justify-between gap-2">
      <h1 lang="pt-PT">
        <span aria-hidden="true">~ </span>Open source contributions
      </h1>
      <span role="img" aria-label={kaomoji.label}>{kaomoji.text}</span>
    </div>
  </header>

  <main>
    <table class="border-2 border-gray-900">
      <thead>
        <tr class="border-b-2 border-gray-900">
          <th scope="col" class="p-2 text-left">Repo</th>
          <th scope="col" class="p-2 text-left">MR/PR</th>
          <th scope="col" class="p-2 text-left">Year</th>
        </tr>
      </thead>
      <tbody>
        {
          data.map((datum) => (
            <tr class="border-b-2 border-gray-900">
              <th scope="row" class="p-2 text-left">
                <a href={datum.url}>{datum.repo}</a>
              </th>
              <td class="p-2 text-left">
                <a href={datum.mr_pr}>{datum.title}</a>
              </td>
              <td class="p-2 text-left">{datum.merged_at.getUTCFullYear()}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </main>

  <footer>
    <p class="font-mono text-sm text-gray-400 selection:text-[#00ff00]!">
      {id}
    </p>
  </footer>
</Layout>
