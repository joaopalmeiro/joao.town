---
import { getCollection } from "astro:content";

import Layout from "../layouts/Base.astro";

const kaomoji = { text: "<(^_^<)", label: "Joyful Kirby" };

const data = await getCollection("contribs");

const totalContribs = data.length;
const totalProjects = new Set(data.map((datum) => datum.data.repo)).size;
---

<Layout title="Open source contributions | João Palmeiro" description="My open source contributions.">
  <header>
    <div class="flex justify-between">
      <h1>
        <span aria-hidden="true">~ </span>Open source contributions
      </h1>
      <span role="img" aria-label={kaomoji.label}>{kaomoji.text}</span>
    </div>

    <dl>
      <div class="flex gap-x-1">
        <dt>Total:</dt>
        <dd>{totalContribs}</dd>
      </div>

      <div class="flex gap-x-1">
        <dt>Projects:</dt>
        <dd>{totalProjects}</dd>
      </div>
    </dl>
  </header>

  <main>
    <div class="overflow-x-auto">
      <table class="border-2 border-gray-900">
        <thead>
          <tr class="border-b-2 border-gray-900">
            <th scope="col" class="p-2 text-left">Repo</th>
            <th scope="col" class="p-2 text-left">MR/PR</th>
            <th scope="col" class="p-2 text-left">Year</th>
          </tr>
        </thead>
        <tbody>
          {
            data.map((datum) => (
              <tr class="border-b-2 border-gray-900">
                <th scope="row" class="p-2 text-left">
                  <a
                    href={datum.data.url}
                    class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
                  >
                    {datum.data.repo}
                  </a>
                </th>
                <td class="p-2 text-left">
                  <a
                    href={datum.data.mr_pr}
                    class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
                  >
                    {datum.data.title}
                  </a>
                </td>
                <td class="p-2 text-left">{datum.data.merged_at.getUTCFullYear()}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </main>
</Layout>
