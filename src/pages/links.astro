      <span role="img" aria-label={kaomoji.label}>{kaomoji.text}</span>
    </div>
  </header>

  <main>
    <ul>
      <li><a href="https://letterboxd.com/joaopalmeiro/">Letterboxd</a></li>
      <li><a href="https://psnprofiles.com/palmeirox">PSNProfiles</a></li>
      <li><a href="https://www.themoviedb.org/u/joaopalmeiro">TMDB</a></li>
    </ul>
  </main>
</Layout>
