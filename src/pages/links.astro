---
import Layout from "../layouts/Base.astro";

const kaomoji = { text: "<(o_o<)", label: "Surprised Kirby" };
---

<Layout title="Links | João Palmeiro" description="My profiles across the web.">
  <header>
    <div class="flex justify-between">
      <h1>
        <span aria-hidden="true">~ </span>Links
      </h1>
      <span role="img" aria-label={kaomoji.label}>{kaomoji.text}</span>
    </div>
  </header>

  <main>
    <ul>
      <li>
        <a
          class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          href="https://bsky.app/profile/joaopalmeiro.bsky.social">Bluesky</a>
      </li>
      <li>
        <a
          class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          href="https://hex.pm/users/palmeiro">Hex</a>
      </li>
      <li>
        <a
          class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          href="https://letterboxd.com/joaopalmeiro/">Letterboxd</a>
      </li>
      <li>
        <a
          class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          href="https://www.npmjs.com/~joaopalmeiro">npm</a>
      </li>
      <li>
        <a
          class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          href="https://psnprofiles.com/palmeirox">PSNProfiles</a>
      </li>
      <li>
        <a
          class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          href="https://pypi.org/user/joaopalmeiro/">PyPI</a>
      </li>
      <li>
        <a
          class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-500"
          href="https://www.themoviedb.org/u/joaopalmeiro">TMDB</a>
      </li>
    </ul>
  </main>
</Layout>
